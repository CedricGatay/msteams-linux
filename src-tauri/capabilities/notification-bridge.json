{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "notification-bridge",
  "description": "Native notifications, zoom and read-only media permission status on the main Teams page, never authentication popups.",
  "windows": ["main"],
  "permissions": [
    "allow-show-notification",
    "allow-notification-permission",
    "allow-close-notification",
    "allow-foreground-notifications-enabled",
    "allow-zoom-teams",
    "allow-media-permission-status"
  ],
  "remote": {
    "urls": [
      "https://teams.cloud.microsoft/*",
      "https://teams.microsoft.com/*"
    ]
  }
}
