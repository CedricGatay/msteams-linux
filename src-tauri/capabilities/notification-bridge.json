{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "notification-bridge",
  "description": "Main Teams integrations: notifications, zoom and read-only media/screen-policy state. Screen state is redacted when the policy is disabled. Never authentication popups.",
  "windows": ["main"],
  "permissions": [
    "allow-show-notification",
    "allow-notification-permission",
    "allow-close-notification",
    "allow-foreground-notifications-enabled",
    "allow-zoom-teams",
    "allow-media-permission-status",
    "allow-screen-presence-status"
  ],
  "remote": {
    "urls": [
      "https://teams.cloud.microsoft/*",
      "https://teams.microsoft.com/*"
    ]
  }
}
