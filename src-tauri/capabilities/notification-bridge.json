{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "notification-bridge",
  "description": "Bridge notifications only from the main Teams page, not authentication popups.",
  "windows": ["main"],
  "permissions": [
    "allow-show-notification",
    "allow-notification-permission",
    "allow-close-notification",
    "allow-foreground-notifications-enabled",
    "allow-zoom-teams"
  ],
  "remote": {
    "urls": [
      "https://teams.cloud.microsoft/*",
      "https://teams.microsoft.com/*"
    ]
  }
}
